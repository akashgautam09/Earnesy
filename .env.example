# ==============================================================================
# EARNESY - Production Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel / Railway / Render production deployment, add these in your project's
# Environment Variables dashboard.
# NEVER commit your actual .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# In production, set to your custom domain or Vercel URL (without trailing slash)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection String
# Get from: MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/earnesy?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION
# ------------------------------------------------------------------------------
# Get from: https://dashboard.clerk.com -> Your App -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ------------------------------------------------------------------------------
# 4. DATA ENCRYPTION (FOR CREATOR RAZORPAY SECRETS)
# ------------------------------------------------------------------------------
# 32-byte hexadecimal key for AES-256-GCM encryption of stored creator API keys.
# Generate in your terminal using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key strictly safe and backed up in production!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. CLOUDINARY (MEDIA & IMAGE UPLOADS)
# ------------------------------------------------------------------------------
# Get from: https://cloudinary.com -> Dashboard -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. DISCORD AUTOMATION (MEMBERSHIP VIP ROLES)
# ------------------------------------------------------------------------------
# Discord Bot Token from: https://discord.com/developers/applications -> Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Bot Invite Link (with Manage Roles permission: 268435456)
NEXT_PUBLIC_DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=268435456&integration_type=0&scope=bot
